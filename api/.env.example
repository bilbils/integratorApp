# LOCAL DEVELOPMENT ONLY.
#
# In production none of this file's values are used. The hosted API runs on
# Render and reads its configuration from Render's environment store (see
# render.yaml). The four secrets below exist there and NOWHERE else - not in
# this repo, not in api/.env, not in a backup file, not in a chat log.
#
# Copy to api/.env for local work. api/.env is gitignored; keep it that way.

# Postgres (Supabase dev - connection string / pooler URL)
# Supabase project: Integrator-App (qlckjrkvmtdhfypsxpqv), region us-east-1.
# If the DB password contains special characters, URL-encode them or use an
# alphanumeric-only password - an unencoded '#' or '@' silently truncates the
# connection string and you get a confusing auth error instead of a parse error.
DATABASE_URL=postgres://user:password@host:5432/postgres

# Machine auth
INGEST_TOKEN=change-me-ingest-token   # pushing highlights (MCP tool + POST /highlights)
JWT_SECRET=change-me-jwt-secret       # admin session signing

# HTTP
# Render injects PORT automatically; config.ts falls back to 3000 locally.
PORT=3000

# AI gateway (OpenRouter). Optional: the API boots and everything else works
# without it - only agent invocation and the model picker need it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GATEWAY_TIMEOUT_MS=60000

# Attribution shown on the OpenRouter dashboard. Optional.
APP_URL=https://github.com/bilbils/integratorApp
APP_TITLE=Staffility Integrator

# Browser origins allowed to call this API (comma separated).
#
# In production this mostly does not fire: the admin reaches the API through a
# Netlify same-origin proxy, so the browser never makes a cross-origin request.
# The hosted origin is listed there anyway (in render.yaml) so direct access
# still works for debugging.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
